# Somobay — environment template.
# ⚠️ শুধু ANON (publishable) key এখানে বসবে। service_role key কখনোই client bundle-এ দেওয়া যাবে না।
# কোনো মান এই ফাইলে কমিট করবেন না — .env.local ব্যবহার করুন (gitignore করা)।
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 1 offline security harness (tests/d02-tenant-isolation.mjs --live) এর জন্য ঐচ্ছিক।
# দুটি আলাদা TEST organization + দুই test user-এর anon-session টোকেন; production মান কখনো নয়।
SOMOBAY_TEST_ORG_A=
SOMOBAY_TEST_ORG_B=
SOMOBAY_TEST_USER_A_TOKEN=
SOMOBAY_TEST_USER_B_TOKEN=
